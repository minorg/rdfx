{
  "compilerOptions": {
    "declaration": true,
    "declarationMap": true,
    "exactOptionalPropertyTypes": false,
    "experimentalDecorators": true,
    "forceConsistentCasingInFileNames": true,
    "lib": [
      "ES2024"
    ],
    "module": "NodeNext",
    "noUncheckedIndexedAccess": false,
    "outDir": "dist",
    "rootDir": "src",
    "sourceMap": true,
    "target": "ES2023",
    "types": []
  },
  "extends": [
    "@tsconfig/strictest/tsconfig.json"
  ],
  "include": [
    "src/**/*.ts"
  ]
}
