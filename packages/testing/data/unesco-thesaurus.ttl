    <http://www.w3.org/2004/02/skos/core#altLabel> "Estudiante internacional"@es, "International students"@en, "Transnational students"@en, "Étudiant international"@fr, "Международные студенты"@ru, "Транснациональные студенты"@ru, "طلاب دوليون"@ar, "طلاب عابرون للحدود"@ar ;
