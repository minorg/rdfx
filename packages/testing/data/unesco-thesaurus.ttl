    a <http://www.w3.org/2004/02/skos/core#Concept> ;
    <http://www.w3.org/2004/02/skos/core#altLabel> "Desplazados"@es, "IDP"@en, "Internally displaced persons"@en, "Перемещенные лица (в пределах страны)"@ru, "مرحلون"@ar, "مشردون داخليا"@ar, "مُهَجرون داخل البلد"@ar, "نازحون"@ar ;
