    <http://www.w3.org/2004/02/skos/core#altLabel> "Agent d'information"@fr, "Experto de la información"@es, "Information officers"@en, "Informatiste"@fr, "Информационные сотрудники"@ru, "مسئولو المعلومات"@ar, "موظفو المعلومات"@ar ;
