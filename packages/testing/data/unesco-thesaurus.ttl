<http://vocabularies.unesco.org/thesaurus/concept7000>
    <http://purl.org/dc/terms/modified> "2019-12-15T13:34:00Z"^^<http://www.w3.org/2001/XMLSchema#dateTime> ;
    a <http://www.w3.org/2004/02/skos/core#Concept> ;
    <http://www.w3.org/2004/02/skos/core#broader> <http://vocabularies.unesco.org/thesaurus/concept256> ;
