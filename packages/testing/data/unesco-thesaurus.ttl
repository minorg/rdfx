    a <http://www.w3.org/2004/02/skos/core#Concept> ;
    <http://www.w3.org/2004/02/skos/core#altLabel> "Formation métiers"@fr, "Initiation au travail"@fr, "Job training"@en, "Occupational training"@en, "Обучение профессии"@ru, "Подготовка по профессии"@ru, "تدريب على العمل"@ar, "تدريب وظيفي"@ar ;
