@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix rdfx: <http://purl.org/rdfx/builder/ontology#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix shaclmate: <http://purl.org/shaclmate/ontology#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

rdfx:RdfsClass
    shaclmate:name "rdfs_Class" ;
    a rdfs:Class, sh:NodeShape ;
    sh:nodeKind sh:IRI ;
    sh:property rdfx:rdfType, rdfx:rdfsComment, rdfx:rdfsIsDefinedBy, rdfx:rdfsLabel, rdfx:rdfsSeeAlso, rdfx:rdfsSubClassOf .

rdfx:rdfsComment
    a sh:PropertyShape ;
    sh:nodeKind sh:Literal ;
    sh:path rdfs:comment .

rdfx:rdfsDomain
    a sh:PropertyShape ;
    sh:nodeKind sh:IRI ;
    sh:path rdfs:domain .

rdfx:rdfsIsDefinedBy
    a sh:PropertyShape ;
    sh:maxCount 1 ;
    sh:nodeKind sh:IRI ;
    sh:path rdfs:isDefinedBy .

rdfx:rdfsLabel
    shaclmate:display true ;
    a sh:PropertyShape ;
    sh:nodeKind sh:Literal ;
    sh:path rdfs:label .

rdfx:rdfxRange
    a sh:PropertyShape ;
    sh:nodeKind sh:IRI ;
    sh:path rdfs:range .

rdfx:rdfsSeeAlso
    a sh:PropertyShape ;
    sh:nodeKind sh:IRIOrLiteral ;
    sh:path rdfs:seeAlso .

rdfx:rdfsSubClassOf
    a sh:PropertyShape ;
    sh:nodeKind sh:IRI ;
    sh:path rdfs:subClassOf .

rdfx:rdfsSubPropertyOf
    a sh:PropertyShape ;
    sh:nodeKind sh:IRI ;
    sh:path rdfs:subPropertyOf .

