@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix shaclmate: <http://purl.org/shaclmate/ontology#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

rdfs:Class
    shaclmate:name "rdfs_Class" ;
    a rdfs:Class, sh:NodeShape ;
    sh:nodeKind sh:IRI ;
    sh:property rdf:type, rdfs:comment, rdfs:isDefinedBy, rdfs:label, rdfs:seeAlso, rdfs:subClassOf .

rdfs:comment
    a sh:PropertyShape ;
    sh:nodeKind sh:Literal ;
    sh:path rdfs:comment .

rdfs:domain
    a sh:PropertyShape ;
    sh:nodeKind sh:IRI ;
    sh:path rdfs:domain .

rdfs:isDefinedBy
    a sh:PropertyShape ;
    sh:maxCount 1 ;
    sh:nodeKind sh:IRI ;
    sh:path rdfs:isDefinedBy .

rdfs:label
    shaclmate:display true ;
    a sh:PropertyShape ;
    sh:nodeKind sh:Literal ;
    sh:path rdfs:label .

rdfs:range
    a sh:PropertyShape ;
    sh:nodeKind sh:IRI ;
    sh:path rdfs:range .

rdfs:seeAlso
    a sh:PropertyShape ;
    sh:nodeKind sh:IRIOrLiteral ;
    sh:path rdfs:seeAlso .

rdfs:subClassOf
    a sh:PropertyShape ;
    sh:nodeKind sh:IRI ;
    sh:path rdfs:subClassOf .

rdfs:subPropertyOf
    a sh:PropertyShape ;
    sh:nodeKind sh:IRI ;
    sh:path rdfs:subPropertyOf .

