@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix shaclmate: <http://purl.org/shaclmate/ontology#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

shaclmate:ShapeList
    a sh:NodeShape ;
    sh:xone ([
            sh:hasValue ( )
        ]
        [
            sh:property [
                sh:maxCount 1 ;
                sh:minCount 1 ;
                sh:xone ( [ sh:nodeKind sh:IRI ] [ sh:node sh:Shape ]) ;
                sh:path rdf:first
            ], [
                sh:maxCount 1 ;
                sh:minCount 1 ;
                sh:node shaclmate:ShapeList ;
                sh:path rdf:rest
            ]
        ]
    ) .

shaclmate:InList
    a sh:NodeShape ;
    sh:xone ([
            sh:hasValue ( )
        ]
        [
            sh:property [
                sh:maxCount 1 ;
                sh:minCount 1 ;
                sh:nodeKind sh:IRIOrLiteral ;
                sh:path rdf:first
            ], [
                sh:maxCount 1 ;
                sh:minCount 1 ;
                sh:node shaclmate:InList ;
                sh:path rdf:rest
            ]
        ]
    ) .

shaclmate:IriList
    a sh:NodeShape ;
    sh:xone ([
            sh:hasValue ( )
        ]
        [
            sh:property [
                sh:maxCount 1 ;
                sh:minCount 1 ;
                sh:nodeKind sh:IRI ;
                sh:path rdf:first
            ], [
                sh:maxCount 1 ;
                sh:minCount 1 ;
                sh:node shaclmate:IriList ;
                sh:path rdf:rest
            ]
        ]
    ) .

shaclmate:PropertyPath
    shaclmate:extern true ;
    shaclmate:name "$PropertyPath" ;
    a sh:NodeShape ;
    rdfs:comment "Extern PropertyPath since shaclmate is not sophisticated enough to deal with all property path variants yet" .

shaclmate:StringList
    a sh:NodeShape ;
    sh:xone ([
            sh:hasValue ( )
        ]
        [
            sh:property [
                sh:datatype xsd:string ;
                sh:maxCount 1 ;
                sh:minCount 1 ;
                sh:path rdf:first
            ], [
                sh:maxCount 1 ;
                sh:minCount 1 ;
                sh:node shaclmate:StringList ;
                sh:path rdf:rest
            ]
        ]
    ) .

sh:NodeShape
    shaclmate:name "sh_NodeShape" ;
    a owl:Class, sh:NodeShape ;
    sh:property rdf:type, rdfs:comment, rdfs:isDefinedBy, rdfs:label, rdfs:subClassOf, sh:NodeShape-closed, sh:NodeShape-ignoredProperties, sh:NodeShape-properties, sh:Shape-and, sh:Shape-classes, sh:Shape-datatype, sh:Shape-deactivated, sh:Shape-flags, sh:Shape-hasValues, sh:Shape-in, sh:Shape-languageIn, sh:Shape-maxExclusive, sh:Shape-maxInclusive, sh:Shape-maxLength, sh:Shape-message, sh:Shape-minExclusive, sh:Shape-minInclusive, sh:Shape-minLength, sh:Shape-node, sh:Shape-nodeKind, sh:Shape-not, sh:Shape-or, sh:Shape-pattern, sh:Shape-severity, sh:Shape-targetClass, sh:Shape-targetNode, sh:Shape-targetObjectsOf, sh:Shape-targetSubjectsOf, sh:Shape-xone .

sh:NodeShape-closed
    a sh:PropertyShape ;
    sh:datatype xsd:boolean ;
    sh:maxCount 1 ;
    sh:path sh:closed .

sh:NodeShape-ignoredProperties
    a sh:PropertyShape ;
    sh:maxCount 1 ;
    sh:node shaclmate:IriList ;
    sh:path sh:ignoredProperties .

sh:NodeShape-properties
    a sh:PropertyShape ;
    sh:xone ( [ sh:nodeKind sh:IRI ] [ sh:node sh:PropertyShape ]) ;
    sh:path sh:property .

sh:PropertyGroup
    shaclmate:name "sh_PropertyGroup" ;
    a owl:Class, sh:NodeShape ;
    sh:property rdfs:comment, rdfs:label .

sh:PropertyShape
    shaclmate:name "sh_PropertyShape" ;
    a owl:Class, sh:NodeShape ;
    sh:property rdfs:comment, rdfs:isDefinedBy, rdfs:label, sh:PropertyShape-defaultValue, sh:PropertyShape-description, sh:PropertyShape-disjoint, sh:PropertyShape-equals, sh:PropertyShape-groups, sh:PropertyShape-lessThan, sh:PropertyShape-lessThanOrEquals, sh:PropertyShape-maxCount, sh:PropertyShape-minCount, sh:PropertyShape-name, sh:PropertyShape-order, sh:PropertyShape-path, sh:PropertyShape-qualifiedMaxCount, sh:PropertyShape-qualifiedMinCount, sh:PropertyShape-qualifiedValueShape, sh:PropertyShape-qualifiedValueShapesDisjoint, sh:PropertyShape-uniqueLang, sh:Shape-and, sh:Shape-classes, sh:Shape-datatype, sh:Shape-deactivated, sh:Shape-flags, sh:Shape-hasValues, sh:Shape-in, sh:Shape-languageIn, sh:Shape-maxExclusive, sh:Shape-maxInclusive, sh:Shape-maxLength, sh:Shape-message, sh:Shape-minExclusive, sh:Shape-minInclusive, sh:Shape-minLength, sh:Shape-node, sh:Shape-nodeKind, sh:Shape-not, sh:Shape-or, sh:Shape-pattern, sh:Shape-severity, sh:Shape-targetClass, sh:Shape-targetNode, sh:Shape-targetObjectsOf, sh:Shape-targetSubjectsOf, sh:Shape-xone .

sh:PropertyShape-defaultValue
    a sh:PropertyShape ;
    sh:maxCount 1 ;
    sh:nodeKind sh:IRIOrLiteral ;
    sh:path sh:defaultValue .

sh:PropertyShape-description
    a sh:PropertyShape ;
    sh:datatype xsd:string ;
    sh:maxCount 1 ;
    sh:path sh:description .

sh:PropertyShape-disjoint
    a sh:PropertyShape ;
    sh:nodeKind sh:IRI ;
    sh:path sh:disjoint .

sh:PropertyShape-equals
    a sh:PropertyShape ;
    sh:nodeKind sh:IRI ;
    sh:path sh:equals .

sh:PropertyShape-groups
    a sh:PropertyShape ;
    sh:xone ( [ sh:nodeKind sh:IRI ] [ sh:node sh:PropertyGroup ]) ;
    sh:path sh:group .

sh:PropertyShape-lessThan
    a sh:PropertyShape ;
    sh:nodeKind sh:IRI ;
    sh:path sh:lessThan .

sh:PropertyShape-lessThanOrEquals
    a sh:PropertyShape ;
    sh:nodeKind sh:IRI ;
    sh:path sh:lessThanOrEquals .

sh:PropertyShape-maxCount
    a sh:PropertyShape ;
    sh:datatype xsd:integer ;
    sh:maxCount 1 ;
    sh:path sh:maxCount .

sh:PropertyShape-minCount
    a sh:PropertyShape ;
    sh:datatype xsd:integer ;
    sh:maxCount 1 ;
    sh:path sh:minCount .

sh:PropertyShape-name
    shaclmate:display true ;
    a sh:PropertyShape ;
    sh:datatype xsd:string ;
    sh:maxCount 1 ;
    sh:path sh:name .

sh:PropertyShape-order
    a sh:PropertyShape ;
    sh:datatype xsd:double ;
    sh:maxCount 1 ;
    sh:path sh:order .

sh:PropertyShape-path
    shaclmate:display true ;
    a sh:PropertyShape ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:node shaclmate:PropertyPath ;
    sh:path sh:path .

sh:PropertyShape-qualifiedMaxCount
    a sh:PropertyShape ;
    sh:datatype xsd:integer ;
    sh:maxCount 1 ;
    sh:path sh:qualifiedMaxCount .

sh:PropertyShape-qualifiedMinCount
    a sh:PropertyShape ;
    sh:datatype xsd:integer ;
    sh:maxCount 1 ;
    sh:path sh:qualifiedMinCount .

sh:PropertyShape-qualifiedValueShape
    a sh:PropertyShape ;
    sh:maxCount 1 ;
    sh:nodeKind sh:BlankNodeOrIRI ;
    sh:path sh:qualifiedValueShape .

sh:PropertyShape-qualifiedValueShapesDisjoint
    a sh:PropertyShape ;
    sh:datatype xsd:boolean ;
    sh:maxCount 1 ;
    sh:path sh:qualifiedValueShapesDisjoint .

sh:PropertyShape-uniqueLang
    a sh:PropertyShape ;
    sh:datatype xsd:boolean ;
    sh:maxCount 1 ;
    sh:path sh:uniqueLang .

sh:Severity
    shaclmate:name "sh_Severity" ;
    a sh:NodeShape ;
    sh:in (sh:Info
        sh:Warning
        sh:Violation
    ) .

sh:Shape
    shaclmate:name "sh_Shape" ;
    a sh:NodeShape ;
    sh:xone (sh:NodeShape
        sh:PropertyShape
    ) .

sh:Shape-and
    a sh:PropertyShape ;
    sh:maxCount 1 ;
    sh:node shaclmate:ShapeList ;
    sh:path sh:and .

sh:Shape-classes
    a sh:PropertyShape ;
    sh:name "classes" ;
    sh:nodeKind sh:IRI ;
    sh:path sh:class .

sh:Shape-datatype
    a sh:PropertyShape ;
    sh:maxCount 1 ;
    sh:nodeKind sh:IRI ;
    sh:path sh:datatype .

sh:Shape-deactivated
    a sh:PropertyShape ;
    sh:datatype xsd:boolean ;
    sh:maxCount 1 ;
    sh:path sh:deactivated .

sh:Shape-flags
    a sh:PropertyShape ;
    sh:datatype xsd:string ;
    sh:maxCount 1 ;
    sh:path sh:flags .

sh:Shape-hasValues
    a sh:PropertyShape ;
    sh:name "hasValues" ;
    sh:nodeKind sh:IRIOrLiteral ;
    sh:path sh:hasValue .

sh:Shape-in
    a sh:PropertyShape ;
    sh:maxCount 1 ;
    sh:name "in_" ;
    sh:node shaclmate:InList ;
    sh:path sh:in .

sh:Shape-languageIn
    a sh:PropertyShape ;
    sh:maxCount 1 ;
    sh:node shaclmate:StringList ;
    sh:path sh:languageIn .

sh:Shape-maxExclusive
    a sh:PropertyShape ;
    sh:maxCount 1 ;
    sh:nodeKind sh:Literal ;
    sh:path sh:maxExclusive .

sh:Shape-maxInclusive
    a sh:PropertyShape ;
    sh:maxCount 1 ;
    sh:nodeKind sh:Literal ;
    sh:path sh:maxInclusive .

sh:Shape-maxLength
    a sh:PropertyShape ;
    sh:datatype xsd:integer ;
    sh:maxCount 1 ;
    sh:path sh:maxLength .

sh:Shape-message
    a sh:PropertyShape ;
    sh:datatype xsd:string ;
    sh:maxCount 1 ;
    sh:path sh:message .

sh:Shape-minExclusive
    a sh:PropertyShape ;
    sh:maxCount 1 ;
    sh:nodeKind sh:Literal ;
    sh:path sh:minExclusive .

sh:Shape-minInclusive
    a sh:PropertyShape ;
    sh:maxCount 1 ;
    sh:nodeKind sh:Literal ;
    sh:path sh:minInclusive .

sh:Shape-minLength
    a sh:PropertyShape ;
    sh:datatype xsd:integer ;
    sh:maxCount 1 ;
    sh:path sh:minLength .

sh:Shape-node
    a sh:PropertyShape ;
    sh:maxCount 1 ;
    sh:xone ( [ sh:nodeKind sh:IRI ] [ sh:node sh:NodeShape ]) ;
    sh:path sh:node .

sh:Shape-nodeKind
    a sh:PropertyShape ;
    sh:in (sh:BlankNode
        sh:BlankNodeOrIRI
        sh:BlankNodeOrLiteral
        sh:IRI
        sh:IRIOrLiteral
        sh:Literal
    ) ;
    sh:maxCount 1 ;
    sh:path sh:nodeKind .

sh:Shape-not
    a sh:PropertyShape ;
    sh:xone ( [ sh:nodeKind sh:IRI ] [ sh:node sh:NodeShape ]) ;
    sh:path sh:not .

sh:Shape-or
    a sh:PropertyShape ;
    sh:maxCount 1 ;
    sh:node shaclmate:ShapeList ;
    sh:path sh:or .

sh:Shape-pattern
    a sh:PropertyShape ;
    sh:datatype xsd:string ;
    sh:maxCount 1 ;
    sh:name "pattern" ;
    sh:path sh:pattern .

sh:Shape-severity
    a sh:PropertyShape ;
    sh:maxCount 1 ;
    sh:node sh:Severity ;
    sh:path sh:severity .

sh:Shape-targetClass
    a sh:PropertyShape ;
    sh:name "targetClasses" ;
    sh:nodeKind sh:IRI ;
    sh:path sh:targetClass .

sh:Shape-targetNode
    a sh:PropertyShape ;
    sh:name "targetNodes" ;
    sh:nodeKind sh:IRIOrLiteral ;
    sh:path sh:targetNode .

sh:Shape-targetObjectsOf
    a sh:PropertyShape ;
    sh:nodeKind sh:IRI ;
    sh:path sh:targetObjectsOf .

sh:Shape-targetSubjectsOf
    a sh:PropertyShape ;
    sh:nodeKind sh:IRI ;
    sh:path sh:targetSubjectsOf .

sh:Shape-xone
    a sh:PropertyShape ;
    sh:maxCount 1 ;
    sh:node shaclmate:ShapeList ;
    sh:path sh:xone .

sh:NodeShape
    sh:property sh:NodeShape-discriminantValue, sh:NodeShape-extern, sh:NodeShape-fromRdfType, sh:NodeShape-rdfType, sh:NodeShape-toRdfTypes, sh:NodeShape-tsImports, shaclmate:Shape-ignore, shaclmate:Shape-mutable, shaclmate:Shape-shaclmateName .

sh:NodeShape-discriminantValue
    a sh:PropertyShape ;
    sh:datatype xsd:string ;
    sh:maxCount 1 ;
    sh:path shaclmate:discriminantValue .

sh:NodeShape-extern
    a sh:PropertyShape ;
    sh:datatype xsd:boolean ;
    sh:maxCount 1 ;
    sh:path shaclmate:extern .

sh:NodeShape-fromRdfType
    a sh:PropertyShape ;
    sh:maxCount 1 ;
    sh:nodeKind sh:IRI ;
    sh:path shaclmate:fromRdfType .

sh:NodeShape-rdfType
    a sh:PropertyShape ;
    sh:maxCount 1 ;
    sh:nodeKind sh:IRI ;
    sh:path shaclmate:rdfType .

sh:NodeShape-toRdfTypes
    a sh:PropertyShape ;
    sh:nodeKind sh:IRI ;
    sh:path shaclmate:toRdfType .

sh:NodeShape-tsImports
    a sh:PropertyShape ;
    sh:datatype xsd:string ;
    sh:name "tsImports" ;
    sh:path shaclmate:tsImport .

sh:PropertyShape
    sh:property sh:PropertyShape-display, sh:PropertyShape-resolve, shaclmate:Shape-ignore, shaclmate:Shape-mutable, shaclmate:Shape-shaclmateName .

sh:PropertyShape-display
    a sh:PropertyShape ;
    rdfs:comment "Whether to include this property in a toString()-type display, defaults to false" ;
    sh:datatype xsd:boolean ;
    sh:defaultValue false ;
    sh:maxCount 1 ;
    sh:path shaclmate:display .

sh:PropertyShape-resolve
    a sh:PropertyShape ;
    sh:maxCount 1 ;
    sh:name "resolve" ;
    sh:nodeKind sh:BlankNodeOrIRI ;
    sh:path shaclmate:resolve .

shaclmate:Shape-ignore
    a sh:PropertyShape ;
    rdfs:comment "Whether to ignore this shape in code generation, defaults to false" ;
    sh:datatype xsd:boolean ;
    sh:defaultValue false ;
    sh:maxCount 1 ;
    sh:path shaclmate:ignore .

shaclmate:Shape-mutable
    a sh:PropertyShape ;
    sh:datatype xsd:boolean ;
    sh:maxCount 1 ;
    sh:path shaclmate:mutable .

shaclmate:Shape-shaclmateName
    shaclmate:display true ;
    a sh:PropertyShape ;
    sh:datatype xsd:string ;
    sh:maxCount 1 ;
    sh:name "shaclmateName" ;
    sh:path shaclmate:name .

