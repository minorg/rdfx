@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix rdfx: <http://purl.org/rdfx/builder/ontology#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix shaclmate: <http://purl.org/shaclmate/ontology#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

rdfx:ShBaseShape
    shaclmate:name "sh_BaseShape" ;
    a sh:NodeShape ;
    sh:property rdfx:ShShape-and, rdfx:ShShape-class, rdfx:ShShape-datatype, rdfx:ShShape-deactivated, rdfx:ShShape-flags, rdfx:ShShape-hasValue, rdfx:ShShape-ignore, rdfx:ShShape-in, rdfx:ShShape-languageIn, rdfx:ShShape-maxExclusive, rdfx:ShShape-maxInclusive, rdfx:ShShape-maxLength, rdfx:ShShape-message, rdfx:ShShape-minExclusive, rdfx:ShShape-minInclusive, rdfx:ShShape-minLength, rdfx:ShShape-mutable, rdfx:ShShape-node, rdfx:ShShape-nodeKind, rdfx:ShShape-not, rdfx:ShShape-or, rdfx:ShShape-pattern, rdfx:ShShape-severity, rdfx:ShShape-shaclmateName, rdfx:ShShape-targetClass, rdfx:ShShape-targetNode, rdfx:ShShape-targetObjectsOf, rdfx:ShShape-targetSubjectsOf, rdfx:ShShape-xone, rdfx:rdfType, rdfx:rdfsComment, rdfx:rdfsIsDefinedBy, rdfx:rdfsLabel, rdfs:subClassOf .

rdfx:ShInList
    a sh:NodeShape ;
    sh:xone ([
            sh:hasValue ( )
        ]
        [
            sh:property [
                sh:maxCount 1 ;
                sh:minCount 1 ;
                sh:nodeKind sh:IRIOrLiteral ;
                sh:path rdf:first
            ], [
                sh:maxCount 1 ;
                sh:minCount 1 ;
                sh:node rdfx:ShInList ;
                sh:path rdf:rest
            ]
        ]
    ) .

rdfx:ShIriList
    a sh:NodeShape ;
    sh:xone ([
            sh:hasValue ( )
        ]
        [
            sh:property [
                sh:maxCount 1 ;
                sh:minCount 1 ;
                sh:nodeKind sh:IRI ;
                sh:path rdf:first
            ], [
                sh:maxCount 1 ;
                sh:minCount 1 ;
                sh:node rdfx:ShIriList ;
                sh:path rdf:rest
            ]
        ]
    ) .

rdfx:ShNodeShape
    shaclmate:name "sh_NodeShape" ;
    sh:and (rdfx:ShBaseShape
        rdfx:ShNodeShapeSpecificProperties
    ) .

rdfx:ShNodeShape-closed
    a sh:PropertyShape ;
    sh:datatype xsd:boolean ;
    sh:maxCount 1 ;
    sh:path sh:closed .

rdfx:ShNodeShape-discriminantValue
    a sh:PropertyShape ;
    sh:datatype xsd:string ;
    sh:maxCount 1 ;
    sh:path shaclmate:discriminantValue .

rdfx:ShNodeShape-extern
    a sh:PropertyShape ;
    sh:datatype xsd:boolean ;
    sh:maxCount 1 ;
    sh:path shaclmate:extern .

rdfx:ShNodeShape-fromRdfType
    a sh:PropertyShape ;
    sh:maxCount 1 ;
    sh:nodeKind sh:IRI ;
    sh:path shaclmate:fromRdfType .

rdfx:ShNodeShape-ignoredProperties
    a sh:PropertyShape ;
    sh:maxCount 1 ;
    sh:node rdfx:ShIriList ;
    sh:path sh:ignoredProperties .

rdfx:ShNodeShape-property
    a sh:PropertyShape ;
    sh:name "properties" ;
    sh:path sh:property ;
    sh:xone ([
            sh:nodeKind sh:IRI
        ]
        [
            sh:node sh:PropertyShape
        ]
    ) .

rdfx:ShNodeShape-rdfType
    a sh:PropertyShape ;
    sh:maxCount 1 ;
    sh:nodeKind sh:IRI ;
    sh:path shaclmate:rdfType .

rdfx:ShNodeShape-toRdfType
    a sh:PropertyShape ;
    sh:name "toRdfTypes" ;
    sh:nodeKind sh:IRI ;
    sh:path shaclmate:toRdfType .

rdfx:ShNodeShape-tsImport
    a sh:PropertyShape ;
    sh:datatype xsd:string ;
    sh:name "tsImports" ;
    sh:path shaclmate:tsImport .

rdfx:ShNodeShapeSpecificProperties
    shaclmate:name "sh_NodeShapeSpecificProperties" ;
    a sh:NodeShape ;
    sh:property rdfx:ShNodeShape-closed, rdfx:ShNodeShape-discriminantValue, rdfx:ShNodeShape-extern, rdfx:ShNodeShape-fromRdfType, rdfx:ShNodeShape-ignoredProperties, rdfx:ShNodeShape-property, rdfx:ShNodeShape-rdfType, rdfx:ShNodeShape-toRdfType, rdfx:ShNodeShape-tsImport .

rdfx:ShPropertyGroup
    shaclmate:name "sh_PropertyGroup" ;
    a sh:NodeShape ;
    sh:property rdfx:rdfsComment, rdfx:rdfsLabel .

rdfx:ShPropertyPath
    shaclmate:extern true ;
    shaclmate:name "$PropertyPath" ;
    a sh:NodeShape ;
    rdfs:comment "Extern PropertyPath since shaclmate is not sophisticated enough to deal with all property path variants yet" .

rdfx:ShPropertyShape
    shaclmate:name "sh_PropertyShape" ;
    sh:and (rdfx:ShBaseShape
        rdfx:ShPropertyShapeSpecificProperties
    ) .

rdfx:ShPropertyShape-defaultValue
    a sh:PropertyShape ;
    sh:maxCount 1 ;
    sh:nodeKind sh:IRIOrLiteral ;
    sh:path sh:defaultValue .

rdfx:ShPropertyShape-description
    a sh:PropertyShape ;
    sh:datatype xsd:string ;
    sh:maxCount 1 ;
    sh:path sh:description .

rdfx:ShPropertyShape-disjoint
    a sh:PropertyShape ;
    sh:nodeKind sh:IRI ;
    sh:path sh:disjoint .

rdfx:ShPropertyShape-display
    a sh:PropertyShape ;
    rdfs:comment "Whether to include this property in a toString()-type display, defaults to false" ;
    sh:datatype xsd:boolean ;
    sh:defaultValue false ;
    sh:maxCount 1 ;
    sh:path shaclmate:display .

rdfx:ShPropertyShape-equals
    a sh:PropertyShape ;
    sh:nodeKind sh:IRI ;
    sh:path sh:equals .

rdfx:ShPropertyShape-group
    a sh:PropertyShape ;
    sh:name "groups" ;
    sh:path sh:group ;
    sh:xone ([
            sh:nodeKind sh:IRI
        ]
        [
            sh:node rdfx:ShPropertyGroup
        ]
    ) .

rdfx:ShPropertyShape-lessThan
    a sh:PropertyShape ;
    sh:nodeKind sh:IRI ;
    sh:path sh:lessThan .

rdfx:ShPropertyShape-lessThanOrEquals
    a sh:PropertyShape ;
    sh:nodeKind sh:IRI ;
    sh:path sh:lessThanOrEquals .

rdfx:ShPropertyShape-maxCount
    a sh:PropertyShape ;
    sh:datatype xsd:integer ;
    sh:maxCount 1 ;
    sh:path sh:maxCount .

rdfx:ShPropertyShape-minCount
    a sh:PropertyShape ;
    sh:datatype xsd:integer ;
    sh:maxCount 1 ;
    sh:path sh:minCount .

rdfx:ShPropertyShape-name
    shaclmate:display true ;
    a sh:PropertyShape ;
    sh:datatype xsd:string ;
    sh:maxCount 1 ;
    sh:path sh:name .

rdfx:ShPropertyShape-order
    a sh:PropertyShape ;
    sh:datatype xsd:double ;
    sh:maxCount 1 ;
    sh:path sh:order .

rdfx:ShPropertyShape-path
    shaclmate:display true ;
    a sh:PropertyShape ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:node rdfx:ShPropertyPath ;
    sh:path sh:path .

rdfx:ShPropertyShape-qualifiedMaxCount
    a sh:PropertyShape ;
    sh:datatype xsd:integer ;
    sh:maxCount 1 ;
    sh:path sh:qualifiedMaxCount .

rdfx:ShPropertyShape-qualifiedMinCount
    a sh:PropertyShape ;
    sh:datatype xsd:integer ;
    sh:maxCount 1 ;
    sh:path sh:qualifiedMinCount .

rdfx:ShPropertyShape-qualifiedValueShape
    a sh:PropertyShape ;
    sh:maxCount 1 ;
    sh:nodeKind sh:BlankNodeOrIRI ;
    sh:path sh:qualifiedValueShape .

rdfx:ShPropertyShape-qualifiedValueShapesDisjoint
    a sh:PropertyShape ;
    sh:datatype xsd:boolean ;
    sh:maxCount 1 ;
    sh:path sh:qualifiedValueShapesDisjoint .

rdfx:ShPropertyShape-resolve
    a sh:PropertyShape ;
    sh:maxCount 1 ;
    sh:name "resolve" ;
    sh:nodeKind sh:BlankNodeOrIRI ;
    sh:path shaclmate:resolve .

rdfx:ShPropertyShape-uniqueLang
    a sh:PropertyShape ;
    sh:datatype xsd:boolean ;
    sh:maxCount 1 ;
    sh:path sh:uniqueLang .

rdfx:ShPropertyShapeSpecificProperties
    shaclmate:name "sh_PropertyShapeSpecificProperties" ;
    a sh:NodeShape ;
    sh:property rdfx:ShPropertyShape-defaultValue, rdfx:ShPropertyShape-description, rdfx:ShPropertyShape-disjoint, rdfx:ShPropertyShape-display, rdfx:ShPropertyShape-equals, rdfx:ShPropertyShape-group, rdfx:ShPropertyShape-lessThan, rdfx:ShPropertyShape-lessThanOrEquals, rdfx:ShPropertyShape-maxCount, rdfx:ShPropertyShape-minCount, rdfx:ShPropertyShape-name, rdfx:ShPropertyShape-order, rdfx:ShPropertyShape-path, rdfx:ShPropertyShape-qualifiedMaxCount, rdfx:ShPropertyShape-qualifiedMinCount, rdfx:ShPropertyShape-qualifiedValueShape, rdfx:ShPropertyShape-qualifiedValueShapesDisjoint, rdfx:ShPropertyShape-resolve, rdfx:ShPropertyShape-uniqueLang .

rdfx:ShSeverity
    shaclmate:name "sh_Severity" ;
    a sh:NodeShape ;
    sh:in (sh:Info
        sh:Warning
        sh:Violation
    ) .

rdfx:ShShape
    shaclmate:name "sh_Shape" ;
    a sh:NodeShape ;
    sh:xone (rdfx:ShNodeShape
        rdfx:ShPropertyShape
    ) .

rdfx:ShShape-and
    a sh:PropertyShape ;
    sh:maxCount 1 ;
    sh:node rdfx:ShShapeList ;
    sh:path sh:and .

rdfx:ShShape-class
    a sh:PropertyShape ;
    sh:name "class_" ;
    sh:nodeKind sh:IRI ;
    sh:path sh:class .

rdfx:ShShape-datatype
    a sh:PropertyShape ;
    sh:maxCount 1 ;
    sh:nodeKind sh:IRI ;
    sh:path sh:datatype .

rdfx:ShShape-deactivated
    a sh:PropertyShape ;
    sh:datatype xsd:boolean ;
    sh:maxCount 1 ;
    sh:path sh:deactivated .

rdfx:ShShape-flags
    a sh:PropertyShape ;
    sh:datatype xsd:string ;
    sh:maxCount 1 ;
    sh:path sh:flags .

rdfx:ShShape-hasValue
    a sh:PropertyShape ;
    sh:name "hasValues" ;
    sh:nodeKind sh:IRIOrLiteral ;
    sh:path sh:hasValue .

rdfx:ShShape-ignore
    a sh:PropertyShape ;
    rdfs:comment "Whether to ignore this shape in code generation, defaults to false" ;
    sh:datatype xsd:boolean ;
    sh:defaultValue false ;
    sh:maxCount 1 ;
    sh:path shaclmate:ignore .

rdfx:ShShape-in
    a sh:PropertyShape ;
    sh:maxCount 1 ;
    sh:name "in_" ;
    sh:node rdfx:ShInList ;
    sh:path sh:in .

rdfx:ShShape-languageIn
    a sh:PropertyShape ;
    sh:maxCount 1 ;
    sh:node rdfx:ShStringList ;
    sh:path sh:languageIn .

rdfx:ShShape-maxExclusive
    a sh:PropertyShape ;
    sh:maxCount 1 ;
    sh:nodeKind sh:Literal ;
    sh:path sh:maxExclusive .

rdfx:ShShape-maxInclusive
    a sh:PropertyShape ;
    sh:maxCount 1 ;
    sh:nodeKind sh:Literal ;
    sh:path sh:maxInclusive .

rdfx:ShShape-maxLength
    a sh:PropertyShape ;
    sh:datatype xsd:integer ;
    sh:maxCount 1 ;
    sh:path sh:maxLength .

rdfx:ShShape-message
    a sh:PropertyShape ;
    sh:datatype xsd:string ;
    sh:maxCount 1 ;
    sh:path sh:message .

rdfx:ShShape-minExclusive
    a sh:PropertyShape ;
    sh:maxCount 1 ;
    sh:nodeKind sh:Literal ;
    sh:path sh:minExclusive .

rdfx:ShShape-minInclusive
    a sh:PropertyShape ;
    sh:maxCount 1 ;
    sh:nodeKind sh:Literal ;
    sh:path sh:minInclusive .

rdfx:ShShape-minLength
    a sh:PropertyShape ;
    sh:datatype xsd:integer ;
    sh:maxCount 1 ;
    sh:path sh:minLength .

rdfx:ShShape-mutable
    a sh:PropertyShape ;
    sh:datatype xsd:boolean ;
    sh:maxCount 1 ;
    sh:path shaclmate:mutable .

rdfx:ShShape-node
    a sh:PropertyShape ;
    sh:maxCount 1 ;
    sh:path sh:node ;
    sh:xone ([
            sh:nodeKind sh:IRI
        ]
        [
            sh:node sh:NodeShape
        ]
    ) .

rdfx:ShShape-nodeKind
    a sh:PropertyShape ;
    sh:in (sh:BlankNode
        sh:BlankNodeOrIRI
        sh:BlankNodeOrLiteral
        sh:IRI
        sh:IRIOrLiteral
        sh:Literal
    ) ;
    sh:maxCount 1 ;
    sh:path sh:nodeKind .

rdfx:ShShape-not
    a sh:PropertyShape ;
    sh:path sh:not ;
    sh:xone ([
            sh:nodeKind sh:IRI
        ]
        [
            sh:node sh:NodeShape
        ]
    ) .

rdfx:ShShape-or
    a sh:PropertyShape ;
    sh:maxCount 1 ;
    sh:node rdfx:ShShapeList ;
    sh:path sh:or .

rdfx:ShShape-pattern
    a sh:PropertyShape ;
    sh:datatype xsd:string ;
    sh:maxCount 1 ;
    sh:name "pattern" ;
    sh:path sh:pattern .

rdfx:ShShape-severity
    a sh:PropertyShape ;
    sh:maxCount 1 ;
    sh:node rdfx:ShSeverity ;
    sh:path sh:severity .

rdfx:ShShape-shaclmateName
    shaclmate:display true ;
    a sh:PropertyShape ;
    sh:datatype xsd:string ;
    sh:maxCount 1 ;
    sh:name "shaclmateName" ;
    sh:path shaclmate:name .

rdfx:ShShape-targetClass
    a sh:PropertyShape ;
    sh:name "targetClasses" ;
    sh:nodeKind sh:IRI ;
    sh:path sh:targetClass .

rdfx:ShShape-targetNode
    a sh:PropertyShape ;
    sh:name "targetNodes" ;
    sh:nodeKind sh:IRIOrLiteral ;
    sh:path sh:targetNode .

rdfx:ShShape-targetObjectsOf
    a sh:PropertyShape ;
    sh:nodeKind sh:IRI ;
    sh:path sh:targetObjectsOf .

rdfx:ShShape-targetSubjectsOf
    a sh:PropertyShape ;
    sh:nodeKind sh:IRI ;
    sh:path sh:targetSubjectsOf .

rdfx:ShShape-xone
    a sh:PropertyShape ;
    sh:maxCount 1 ;
    sh:node rdfx:ShShapeList ;
    sh:path sh:xone .

rdfx:ShShapeList
    a sh:NodeShape ;
    sh:xone ([
            sh:hasValue ( )
        ]
        [
            sh:property [
                sh:maxCount 1 ;
                sh:minCount 1 ;
                sh:path rdf:first ;
                sh:xone ([
                        sh:nodeKind sh:IRI
                    ]
                    [
                        sh:node sh:Shape
                    ]
                )
            ], [
                sh:maxCount 1 ;
                sh:minCount 1 ;
                sh:node rdfx:ShShapeList ;
                sh:path rdf:rest
            ]
        ]
    ) .

rdfx:ShStringList
    a sh:NodeShape ;
    sh:xone ([
            sh:hasValue ( )
        ]
        [
            sh:property [
                sh:datatype xsd:string ;
                sh:maxCount 1 ;
                sh:minCount 1 ;
                sh:path rdf:first
            ], [
                sh:maxCount 1 ;
                sh:minCount 1 ;
                sh:node rdfx:ShStringList ;
                sh:path rdf:rest
            ]
        ]
    ) .

