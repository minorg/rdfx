@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix rdfx: <http://purl.org/rdfx/builder/ontology#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix shaclmate: <http://purl.org/shaclmate/ontology#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

rdfx:RdfProperty
    shaclmate:name "rdf_Property" ;
    a rdfs:Class, sh:NodeShape ;
    sh:nodeKind sh:IRI ;
    sh:property rdfx:rdfType, rdfx:rdfsComment, rdfx:rdfsDomain, rdfx:rdfsIsDefinedBy, rdfx:rdfsLabel, rdfx:rdfsRange, rdfx:rdfsSeeAlso, rdfx:rdfsSubPropertyOf .

rdfx:RdfStatement
    shaclmate:name "rdf_Statement" ;
    a rdfs:Class, sh:NodeShape ;
    sh:property rdfx:rdfObject, rdfx:rdfPredicate, rdfx:rdfSubject, rdfx:rdfType, rdfx:rdfsComment, rdfx:rdfsIsDefinedBy, rdfx:rdfsLabel, rdfx:rdfsSeeAlso .

rdfx:rdfObject
    a sh:PropertyShape ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:path rdf:object .

rdfx:rdfPredicate
    a sh:PropertyShape ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:nodeKind sh:IRI ;
    sh:path rdf:predicate .

rdfx:rdfSubject
    a sh:PropertyShape ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:path rdf:subject .

rdfx:rdfType
    a sh:PropertyShape ;
    sh:nodeKind sh:IRI ;
    sh:path rdf:type .

