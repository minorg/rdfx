@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix shaclmate: <http://purl.org/shaclmate/ontology#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

rdf:Property
    shaclmate:name "rdf_Property" ;
    a rdfs:Class, sh:NodeShape ;
    sh:property rdf:type, rdfs:comment, rdfs:domain, rdfs:isDefinedBy, rdfs:label, rdfs:range, rdfs:seeAlso, rdfs:subPropertyOf .

rdf:Statement
    shaclmate:name "rdf_Statement" ;
    a rdfs:Class, sh:NodeShape ;
    sh:property rdf:object, rdf:predicate, rdf:subject, rdf:type, rdfs:comment, rdfs:label .

rdf:object
    a sh:PropertyShape ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:path rdf:object .

rdf:predicate
    a sh:PropertyShape ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:nodeKind sh:IRI ;
    sh:path rdf:predicate .

rdf:subject
    a sh:PropertyShape ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:path rdf:subject .

rdf:type
    a sh:PropertyShape ;
    sh:nodeKind sh:IRI ;
    sh:path rdf:type .

