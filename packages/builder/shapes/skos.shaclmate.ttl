@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix rdfx: <http://purl.org/rdfx/builder/ontology#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix shaclmate: <http://purl.org/shaclmate/ontology#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

rdfx:SkosConcept
    shaclmate:name "skos_Concept" ;
    a owl:Class, sh:NodeShape ;
    sh:nodeKind sh:IRI ;
    sh:property rdfx:SkosConcept-broader, rdfx:rdfType, rdfx:skosAltLabel, rdfx:skosDefinition, rdfx:skosHiddenLabel, rdfx:skosNotation, rdfx:skosPrefLabel .

rdfx:SkosConcept-broader
    a sh:PropertyShape ;
    sh:name "broader" ;
    sh:path skos:broader ;
    sh:xone ([
            sh:nodeKind sh:IRI
        ]
        [
            sh:node rdfx:SkosConcept
        ]
    ) .

rdfx:SkosConceptScheme
    shaclmate:name "skos_ConceptScheme" ;
    a owl:Class, sh:NodeShape ;
    sh:nodeKind sh:IRI ;
    sh:property rdfx:SkosConceptScheme-concepts, rdfx:SkosConceptScheme-topConcepts, rdfx:rdfType, rdfx:skosAltLabel, rdfx:skosDefinition, rdfx:skosHiddenLabel, rdfx:skosNotation, rdfx:skosPrefLabel .

rdfx:SkosConceptScheme-concepts
    a sh:PropertyShape ;
    sh:name "concepts" ;
    sh:path [
        sh:inversePath skos:inScheme
    ] ;
    sh:xone ([
            sh:nodeKind sh:IRI
        ]
        [
            sh:node rdfx:SkosConcept
        ]
    ) .

rdfx:SkosConceptScheme-topConcepts
    a sh:PropertyShape ;
    sh:name "topConcepts" ;
    sh:path [
        sh:inversePath skos:topConceptOf
    ] ;
    sh:xone ([
            sh:nodeKind sh:IRI
        ]
        [
            sh:node rdfx:SkosConcept
        ]
    ) .

rdfx:skosAltLabel
    a sh:PropertyShape ;
    sh:name "altLabel" ;
    sh:path skos:altLabel ;
    sh:xone ([
            sh:datatype xsd:string
        ]
        [
            sh:datatype rdf:langString
        ]
    ) .

rdfx:skosDefinition
    a sh:PropertyShape ;
    sh:name "definition" ;
    sh:path skos:definition ;
    sh:xone ([
            sh:datatype xsd:string
        ]
        [
            sh:datatype rdf:langString
        ]
    ) .

rdfx:skosHiddenLabel
    a sh:PropertyShape ;
    sh:name "hiddenLabel" ;
    sh:path skos:hiddenLabel ;
    sh:xone ([
            sh:datatype xsd:string
        ]
        [
            sh:datatype rdf:langString
        ]
    ) .

rdfx:skosNotation
    a sh:PropertyShape ;
    sh:name "notation" ;
    sh:nodeKind sh:Literal ;
    sh:path skos:notation .

rdfx:skosPrefLabel
    a sh:PropertyShape ;
    sh:name "prefLabel" ;
    sh:path skos:prefLabel ;
    sh:xone ([
            sh:datatype xsd:string
        ]
        [
            sh:datatype rdf:langString
        ]
    ) .

