{
  "compilerOptions": {
    "declaration": true,
    "declarationMap": true,
    "exactOptionalPropertyTypes": false,
    "forceConsistentCasingInFileNames": true,
    "lib": [
      "ES2023"
    ],
    "module": "Node16",
    "noUncheckedIndexedAccess": false,
    "outDir": "dist",
    "rootDir": "src",
    "sourceMap": true,
    "target": "ES2023",
    "moduleResolution": "node16",
    "types": [
      "node"
    ]
  },
  "extends": [
    "@tsconfig/strictest/tsconfig.json"
  ],
  "include": [
    "src/**/*.ts"
  ]
}
