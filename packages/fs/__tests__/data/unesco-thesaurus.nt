<http://vocabularies.unesco.org/thesaurus/concept670> <http://www.w3.org/2004/02/skos/core#scopeNote> "\u0627\u0633\u062A\u062E\u062F\u0645 \u0644\u0644\u0625\u0634\u0627\u0631\u0629 \u0625\u0644\u0649 \u062B\u0644\u0627\u062B\u0629 \u0623\u0646\u0648\u0627\u0639 \u0645\u0646 \u0627\u0644\u0645\u0647\u0627\u0645: \u0627\u0644\u0645\u0633\u0626\u0648\u0644\u064A\u0629 \u0648\u0627\u0644\u0625\u0634\u0631\u0627\u0641 \u0639\u0644\u0649 \u0639\u0645\u0644 \u0627\u0644\u0622\u062E\u0631\u064A\u0646\u060C \u0625\u0633\u0646\u0627\u062F \u0627\u0644\u0639\u0645\u0627\u0644\u0629\u060C \u0627\u0644\u0645\u0648\u0627\u062F \u0648\u0631\u0623\u0633 \u0627\u0644\u0645\u0627\u0644 \u0644\u0625\u0646\u062A\u0627\u062C\u064A\u0629 \u0639\u0627\u0644\u064A\u0629 \u0627\u0644\u0623\u062F\u0627\u0621\u060C \u0648\u0635\u0646\u0639 \u0627\u0644\u0642\u0631\u0627\u0631."@ar .
