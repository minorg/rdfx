<http://vocabularies.unesco.org/thesaurus/concept5569> <http://www.w3.org/2004/02/skos/core#scopeNote> "\u0421\u0442\u0430\u043D\u0434\u0430\u0440\u0442\u044B \u0432 \u043E\u0442\u043D\u043E\u0448\u0435\u043D\u0438\u0438 \u0442\u0440\u0443\u0434\u043E\u0432\u043E\u0433\u043E \u043D\u0430\u0439\u043C\u0430 \u0438 \u0443\u0441\u043B\u043E\u0432\u0438\u0439 \u0442\u0440\u0443\u0434\u0430, \u0437\u0430\u0444\u0438\u043A\u0441\u0438\u0440\u043E\u0432\u0430\u043D\u043D\u044B\u0435 \u0432 \u043A\u043E\u043B\u043B\u0435\u043A\u0442\u0438\u0432\u043D\u044B\u0445 \u0434\u043E\u0433\u043E\u0432\u043E\u0440\u0430\u0445 \u043C\u0435\u0436\u0434\u0443 \u0440\u0430\u0431\u043E\u0442\u043E\u0434\u0430\u0442\u0435\u043B\u044F\u043C\u0438 \u0438 \u0440\u0430\u0431\u043E\u0442\u043D\u0438\u043A\u0430\u043C\u0438, \u0432 \u0442\u0440\u0443\u0434\u043E\u0432\u044B\u0445 \u0437\u0430\u043A\u043E\u043D\u0430\u0445 \u0438\u043B\u0438 \u043D\u043E\u0440\u043C\u0430\u0442\u0438\u0432\u043D\u044B\u0445 \u0430\u043A\u0442\u0430\u0445, \u043F\u0440\u0438\u043D\u044F\u0442\u044B\u0445 \u0437\u0430\u043A\u043E\u043D\u043E\u0434\u0430\u0442\u0435\u043B\u044C\u043D\u043E\u0439 \u0432\u043B\u0430\u0441\u0442\u044C\u044E."@ru .
<http://vocabularies.unesco.org/thesaurus/concept5569> <http://www.w3.org/2004/02/skos/core#scopeNote> "\u0627\u0644\u0645\u0639\u0627\u064A\u064A\u0631 \u0627\u0644\u0645\u062A\u0639\u0644\u0642\u0629 \u0628\u0634\u0631\u0648\u0637 \u0627\u0644\u062A\u0648\u0638\u064A\u0641 \u0648\u0627\u0644\u0639\u0645\u0644 \u0627\u0644\u0645\u0646\u0635\u0648\u0635 \u0639\u0644\u064A\u0647\u0627 \u0641\u064A \u0627\u0644\u0627\u062A\u0641\u0627\u0642\u0627\u062A \u0627\u0644\u062C\u0645\u0627\u0639\u064A\u0629 \u0628\u064A\u0646 \u0623\u0635\u062D\u0627\u0628 \u0627\u0644\u0639\u0645\u0644 \u0648\u0627\u0644\u0639\u0627\u0645\u0644\u064A\u0646 \u0623\u0648 \u0641\u064A \u0642\u0648\u0627\u0646\u064A\u0646 \u0627\u0644\u0639\u0645\u0644 \u0648\u0627\u0644\u0644\u0648\u0627\u0626\u062D \u0627\u0644\u0645\u0639\u062A\u0645\u062F\u0629 \u0645\u0646 \u0627\u0644\u0633\u0644\u0637\u0629 \u0627\u0644\u062A\u0634\u0631\u064A\u0639\u064A\u0629."@ar .
