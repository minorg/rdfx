<http://vocabularies.unesco.org/thesaurus/concept17047> <http://www.w3.org/2004/02/skos/core#scopeNote> "\u0424\u0438\u0437\u0438\u0447\u0435\u0441\u043A\u043E\u0435 \u043B\u0438\u0446\u043E, \u0433\u0440\u0443\u043F\u043F\u0430 \u043B\u0438\u0446, \u0443\u0447\u0440\u0435\u0436\u0434\u0435\u043D\u0438\u0435, \u0433\u043E\u0441\u0443\u0434\u0430\u0440\u0441\u0442\u0432\u043E, \u043F\u0440\u043E\u044F\u0432\u043B\u044F\u044E\u0449\u0438\u0435 \u0438\u043D\u0442\u0435\u0440\u0435\u0441 \u0438\u043B\u0438 \u0443\u0447\u0430\u0441\u0442\u0438\u0435 \u043A \u043A\u043E\u043D\u043A\u0440\u0435\u0442\u043D\u044B\u043C \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u044F\u043C \u0438\u043B\u0438 \u043F\u0440\u0435\u0434\u043B\u043E\u0436\u0435\u043D\u0438\u044F\u043C, \u043F\u043E\u0441\u0442\u0443\u043F\u0438\u0432\u0448\u0438\u043C \u043E\u0442 \u043E\u0440\u0433\u0430\u043D\u0438\u0437\u0430\u0446\u0438\u0438."@ru .
<http://vocabularies.unesco.org/thesaurus/concept17047> <http://www.w3.org/2004/02/skos/core#scopeNote> "\u0627\u0647\u062A\u0645\u0627\u0645 \u0623\u0648 \u0645\u0635\u0644\u062D\u0629 \u0641\u0631\u062F \u0623\u0648 \u0645\u062C\u0645\u0648\u0639\u0629 \u0623\u0648 \u0645\u0624\u0633\u0633\u0629 \u0623\u0648 \u0633\u0644\u0637\u0629 \u062D\u0643\u0645 \u0641\u064A \u0627\u062A\u062E\u0627\u0630 \u062A\u062F\u0628\u064A\u0631 \u0645\u0639\u064A\u0646 \u0623\u0648 \u0627\u0642\u062A\u0631\u0627\u062D \u0645\u0642\u062F\u0645 \u0645\u0646 \u0645\u0646\u0638\u0645\u0629."@ar .
