<http://vocabularies.unesco.org/thesaurus/concept4483> <http://www.w3.org/2004/02/skos/core#scopeNote> "\u0418\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u0435\u0442\u0441\u044F \u043F\u043E \u043E\u0442\u043D\u043E\u0448\u0435\u043D\u0438\u044E \u043A \u0441\u043E\u0431\u044B\u0442\u0438\u044F\u043C, \u043F\u0440\u043E\u0438\u0441\u0445\u043E\u0434\u0438\u0432\u0448\u0438\u043C \u0434\u043E 1991 \u0433., \u0432 \u0438\u043D\u044B\u0445 \u0441\u043B\u0443\u0447\u0430\u044F\u0445 \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u0439\u0442\u0435 \u0442\u0435\u0440\u043C\u0438\u043D \"\u0411\u0435\u043B\u0430\u0440\u0443\u0441\u044C\"."@ru .
