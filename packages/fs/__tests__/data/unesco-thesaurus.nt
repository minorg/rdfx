<http://vocabularies.unesco.org/thesaurus/concept16994> <http://www.w3.org/2004/02/skos/core#scopeNote> "\u0420\u0430\u0437\u043B\u0438\u0447\u0438\u044F \u0432 \u0434\u043E\u0441\u0442\u0443\u043F\u0435 \u0438 \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u043D\u0438\u0438 \u0438\u043D\u0444\u043E\u0440\u043C\u0430\u0446\u0438\u043E\u043D\u043D\u044B\u0445 \u0438 \u043A\u043E\u043C\u043C\u0443\u043D\u0438\u043A\u0430\u0446\u0438\u043E\u043D\u043D\u044B\u0445 \u0442\u0435\u0445\u043D\u043E\u043B\u043E\u0433\u0438\u0439, \u0442\u0430\u043A\u0438\u0445 \u043A\u0430\u043A \u0418\u043D\u0442\u0435\u0440\u043D\u0435\u0442, \u043E\u0442\u043C\u0435\u0447\u0430\u0435\u043C\u044B\u0435 \u043A\u0430\u043A \u043C\u0435\u0436\u0434\u0443 \u043E\u0442\u0434\u0435\u043B\u044C\u043D\u044B\u043C\u0438 \u0441\u0442\u0440\u0430\u043D\u0430\u043C\u0438, \u0442\u0430\u043A \u0438 \u043C\u0435\u0436\u0434\u0443 \u043E\u0442\u0434\u0435\u043B\u044C\u043D\u044B\u043C\u0438 \u0440\u0435\u0433\u0438\u043E\u043D\u0430\u043C\u0438 \u0432 \u043F\u0440\u0435\u0434\u0435\u043B\u0430\u0445 \u043E\u0434\u043D\u043E\u0439 \u0441\u0442\u0440\u0430\u043D\u044B."@ru .
<http://vocabularies.unesco.org/thesaurus/concept16994> <http://www.w3.org/2004/02/skos/core#scopeNote> "\u0627\u0644\u062A\u0628\u0627\u064A\u0646 \u0628\u064A\u0646 \u0627\u0644\u062F\u0648\u0644 \u0623\u0648 \u062F\u0627\u062E\u0644 \u0627\u0644\u062F\u0648\u0644\u0629 \u0627\u0644\u0648\u0627\u062D\u062F\u0629 \u0641\u064A \u0625\u0645\u0643\u0627\u0646\u064A\u0629 \u0627\u0644\u0648\u0635\u0648\u0644 \u0625\u0644\u0649 \u062A\u0643\u0646\u0648\u0644\u0648\u062C\u064A\u0627 \u0627\u0644\u0645\u0639\u0644\u0648\u0645\u0627\u062A \u0648\u0627\u0644\u0627\u062A\u0635\u0627\u0644\u0627\u062A \u0643\u0627\u0644\u0625\u0646\u062A\u0631\u0646\u062A \u0648\u0645\u0646 \u062B\u0645 \u0627\u0633\u062A\u062E\u062F\u0627\u0645\u0647\u0627."@ar .
