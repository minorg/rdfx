{
  "devDependencies": {
    "@biomejs/biome": "2.3.10",
    "@tsconfig/node24": "^24",
    "@tsconfig/strictest": "~2.0.8",
    "@types/node": "^24",
    "@vitest/coverage-v8": "~4.1.5",
    "depcheck": "~1.4.7",
    "rimraf": "~6.0.1",
    "tsx": "~4.16.2",
    "turbo": "~2.5.5",
    "typescript": "6.0.3",
    "vitest": "~4.1.5",
    "vitest-fetch-mock": "~0.4.5"
  },
  "name": "rdfx",
  "optionalDependencies": {
    "@biomejs/cli-linux-x64": "2.3.10"
  },
  "packageManager": "npm@11.11.0",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "check": "biome check",
    "check:write": "biome check --write",
    "check:write:unsafe": "biome check --write --unsafe",
    "clean": "turbo run clean",
    "depcheck": "turbo run depcheck",
    "dev": "turbo run --concurrency 23 dev dev:tests",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "workspaces": [
    "packages/builder",
    "packages/collection",
    "packages/data-factory",
    "packages/fs",
    "packages/git",
    "packages/graph-store",
    "packages/literal",
    "packages/parsers",
    "packages/resource",
    "packages/serializers",
    "packages/sparql-client",
    "packages/string",
    "packages/testing"
  ]
}
